# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Database Configuration - Trading System
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
TRADING_DB_NAME=trading_system

# Backup (optional): pg_dump path if not in PATH (Windows default: PostgreSQL 18)
# PGDMP_PATH=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Alpaca Trading API (paper trading only - see PAPER_TRADING in
# src/services/alpaca/client.py; there is no env switch for live trading)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Email Configuration (Optional - notifier no-ops when unset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_TO_EMAIL=your-email@gmail.com

# ============================================
# Prefect Configuration (Essential)
# ============================================
PREFECT_API_URL=http://localhost:4200/api
PREFECT_API_DATABASE_CONNECTION_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/prefect
PREFECT_WORK_POOL_DATA_INGESTION=data-ingestion-pool
